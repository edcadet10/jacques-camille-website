# API Keys - Fill in your own keys and rename this file to .env.local
# For production, set these in your hosting environment (e.g., Netlify)
NEXT_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Netlify Identity settings - these are automatically added by Netlify in production
NETLIFY_IDENTITY_ENABLED=true

# Website general settings
NEXT_PUBLIC_SITE_URL=https://jacques-camille.netlify.app
NEXT_PUBLIC_SITE_NAME=Jacques Evens Camille - Executive Leadership Coach

# Admin functionality
ADMIN_EMAIL=admin@jacques-camille.com
